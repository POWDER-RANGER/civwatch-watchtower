# Copy to .env and adjust for local development
# docker-compose defaults match the values below

NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://civwatch:changeme@localhost:5432/civwatch

# Redis (optional until rate limiting / pub-sub is wired)
# REDIS_URL=redis://localhost:6379

# Browser API origins (comma-separated; leave blank for same-origin server deployments)
CORS_ORIGINS=

# Production bearer token for POST /api/features and POST /api/reports
WATCHTOWER_WRITE_TOKEN=

# Meilisearch (optional until search is wired)
# MEILI_HOST=http://localhost:7700
# MEILI_MASTER_KEY=masterkey

# Mapbox (Phase 3)
# VITE_MAPBOX_TOKEN=
