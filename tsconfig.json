{
  "include": [
    "client/src/**/*",
    "shared/**/*",
    "server/**/*",
    "packages/*/src/**/*"
  ],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@civwatch/types": ["./packages/types/src/index.ts"],
      "@civwatch/types/*": ["./packages/types/src/*"],
      "@civwatch/config": ["./packages/config/src/index.ts"],
      "@civwatch/config/*": ["./packages/config/src/*"],
      "@civwatch/core": ["./packages/core/src/index.ts"],
      "@civwatch/core/*": ["./packages/core/src/*"],
      "@civwatch/api-client": ["./packages/api-client/src/index.ts"],
      "@civwatch/api-client/*": ["./packages/api-client/src/*"],
      "@civwatch/ui": ["./packages/ui/src/index.ts"],
      "@civwatch/ui/*": ["./packages/ui/src/*"]
    }
  }
}
